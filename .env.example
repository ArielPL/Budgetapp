# Supabase — optional cross-device sync. Copy this file to .env.local and fill in.
# Without these, the app runs exactly as before: local-only, no account, no sync.
# The publishable key is safe to embed client-side — RLS scopes every row to the
# signed-in user (auth.uid() = user_id), so it grants no access on its own.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
